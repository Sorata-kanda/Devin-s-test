<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editor</title>
    <link rel="stylesheet" href="/css/new.css">
</head>
<body>
    <h2>Edit your post</h2>
    <div class="main">
        <form method="post" action="/posts/<%=poster.id%>?_method=PATCH">
            <div class="users">
                <h5>Enter Username: </h5> <br>
                <input type="text" name="Username" id="" placeholder="Username" value="<%=poster.user%>">
            </div>
            
            <div class="content">
                <h5>Please Enter the Post Content:</h5>
                <br>
                <textarea name="Content" id="" placeholder="Write your post"><%=poster.content%></textarea>
            </div>

            <button class="Submit">Submit Post</button>
        </form>
    </div>
</body>
</html>